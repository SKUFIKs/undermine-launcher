<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">

        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <!-- Статические начертания Montserrat. Переменный шрифт в Avalonia 11
             не инстанцирует ось веса: FontWeight (Bold/ExtraBold/Black)
             игнорировался и весь текст рендерился обычным начертанием —
             получался тонкий, плохо читаемый текст. Поэтому каждое начертание
             подключено отдельным файлом.
             ВАЖНО: Skia (в отличие от GDI+) называет семью у всех файлов
             просто "Montserrat", поэтому в avares-URI всегда #Montserrat. -->
        <FontFamily x:Key="MontRegular">avares://UnderMineLauncher/Assets/Fonts/Montserrat-Regular.ttf#Montserrat, avares://UnderMineLauncher/Assets/Fonts/Montserrat-Italic.ttf#Montserrat, avares://UnderMineLauncher/Assets/Fonts/Montserrat-Bold.ttf#Montserrat, avares://UnderMineLauncher/Assets/Fonts/Montserrat-BoldItalic.ttf#Montserrat</FontFamily>
        <FontFamily x:Key="MontSemiBold">avares://UnderMineLauncher/Assets/Fonts/Montserrat-SemiBold.ttf#Montserrat, avares://UnderMineLauncher/Assets/Fonts/Montserrat-SemiBoldItalic.ttf#Montserrat</FontFamily>
        <FontFamily x:Key="MontMedium">avares://UnderMineLauncher/Assets/Fonts/Montserrat-Medium.ttf#Montserrat</FontFamily>
        <FontFamily x:Key="MontExtraBold">avares://UnderMineLauncher/Assets/Fonts/Montserrat-ExtraBold.ttf#Montserrat</FontFamily>
        <FontFamily x:Key="MontBlack">avares://UnderMineLauncher/Assets/Fonts/Montserrat-Black.ttf#Montserrat</FontFamily>
    </Styles.Resources>

    <!-- ==================== Общий текст ==================== -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MontRegular}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Label">
        <Setter Property="FontFamily" Value="{StaticResource MontRegular}" />
    </Style>

    <!-- ==================== Кнопки: базовый вид ==================== -->
    <Style Selector="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource MontRegular}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ==================== Поля ввода (TextBox) ====================
         Состояния :pointerover / :focus / :disabled задаются явными стилями
         приложения для Border#PART_BorderElement. Без них тема Fluent
         подставляет в фокусе системный цвет фона. -->

    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="#1C1C1C" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#6E6E6E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="#FFFFFF" />
        <Setter Property="SelectionBrush" Value="#E76F2A" />
        <Setter Property="SelectionForegroundBrush" Value="#FFFFFF" />
    </Style>

    <!-- Порядок важен: pointerover -> focus -> disabled, внутри каждого —
         сначала базовый селектор, затем классы (побеждает более поздний). -->
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#242424" />
        <Setter Property="BorderBrush" Value="#8A8A8A" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox.custom-textbox">
        <Setter Property="FontFamily" Value="{StaticResource MontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="#141414" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#8A8A8A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.custom-textbox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#1A1A1A" />
        <Setter Property="BorderBrush" Value="#A6A6A6" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox.custom-paneltextbox">
        <Setter Property="FontFamily" Value="{StaticResource MontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="#141414" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#8A8A8A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.custom-paneltextbox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#1A1A1A" />
        <Setter Property="BorderBrush" Value="#A6A6A6" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#1C1C1C" />
        <Setter Property="BorderBrush" Value="#E76F2A" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox.custom-textbox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#1A1A1A" />
        <Setter Property="BorderBrush" Value="#E76F2A" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox.custom-paneltextbox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#1A1A1A" />
        <Setter Property="BorderBrush" Value="#E76F2A" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox:disabled">
        <Setter Property="Foreground" Value="#7A7A7A" />
    </Style>

    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#262626" />
        <Setter Property="BorderBrush" Value="#3A3A3A" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ==================== Подписи ==================== -->
    <Style Selector="Label.LiteLabel">
        <Setter Property="FontFamily" Value="{StaticResource MontSemiBold}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="5,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontStyle" Value="Italic" />
    </Style>

    <!-- Кнопки-ссылки (переключение между авторизацией и регистрацией) -->
    <Style Selector="Button.LiteLabel">
        <Setter Property="FontFamily" Value="{StaticResource MontSemiBold}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="5,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#CFCFCF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.LiteLabel:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.LiteLabel:pressed">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#E76F2A" />
    </Style>

    <Style Selector="Label.BigTitle">
        <Setter Property="FontFamily" Value="{StaticResource MontExtraBold}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Label.LiteTitle">
        <Setter Property="FontFamily" Value="{StaticResource MontExtraBold}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Label.NewsTitle">
        <Setter Property="FontFamily" Value="{StaticResource MontExtraBold}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="TextBlock.LiteTitle">
        <Setter Property="FontFamily" Value="{StaticResource MontMedium}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ==================== Список серверов ==================== -->
    <Style Selector="ListBox.ServerList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBoxItem.ServerItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ListBoxItem.ServerItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2E2E2E" />
    </Style>

    <Style Selector="ListBoxItem.ServerItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#333333" />
        <Setter Property="BorderBrush" Value="#E76F2A" />
    </Style>

    <!-- ==================== Текстовые ссылки ==================== -->
    <Style Selector="Button.custom-Link">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="5,10" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="#CFCFCF" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.custom-Link:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.custom-Link:pressed">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#E76F2A" />
    </Style>

    <!-- ==================== Основная кнопка (оранжевая) ==================== -->
    <Style Selector="Button.custom-Auth">
        <Setter Property="Width" Value="215" />
        <Setter Property="Height" Value="56.25" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource MontBlack}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="#E76F2A" />
        <Setter Property="CornerRadius" Value="15" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.custom-Auth:pointerover">
        <Setter Property="Background" Value="#F0834A" />
    </Style>

    <Style Selector="Button.custom-Auth:pressed">
        <Setter Property="Background" Value="#C25E1E" />
    </Style>

    <Style Selector="Button.custom-Auth:disabled">
        <Setter Property="Background" Value="#4A4A4A" />
        <Setter Property="Foreground" Value="#9A9A9A" />
    </Style>

    <!-- ==================== Вторичная кнопка (Browse) ==================== -->
    <Style Selector="Button.secondary">
        <Setter Property="Height" Value="35" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource MontSemiBold}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="#3A3A3A" />
        <Setter Property="CornerRadius" Value="8" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Background" Value="#4A4A4A" />
    </Style>

    <Style Selector="Button.secondary:pressed">
        <Setter Property="Background" Value="#E76F2A" />
    </Style>

    <!-- ==================== Кнопки бокового меню ==================== -->
    <Style Selector="RadioButton.menu-btn">
        <Setter Property="Width" Value="215" />
        <Setter Property="Height" Value="56.25" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource MontRegular}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="10">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"
                                      Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="RadioButton.menu-btn:pointerover /template/ Border#border">
        <Setter Property="Background" Value="#2E2E2E" />
    </Style>

    <Style Selector="RadioButton.menu-btn:checked /template/ Border#border">
        <Setter Property="Background" Value="#E76F2A" />
    </Style>

    <Style Selector="Button.menu-btn">
        <Setter Property="Width" Value="215" />
        <Setter Property="Height" Value="56.25" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource MontRegular}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="#2A2A2A" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="10">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"
                                      Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.menu-btn:pointerover /template/ Border#border">
        <Setter Property="Background" Value="#444444" />
    </Style>

    <Style Selector="Button.menu-btn:pressed /template/ Border#border">
        <Setter Property="Background" Value="#E76F2A" />
    </Style>

    <Style Selector="Button.menu-btn:disabled /template/ Border#border">
        <Setter Property="Background" Value="#2A2A2A" />
    </Style>

    <Style Selector="Button.menu-btn:disabled">
        <Setter Property="Foreground" Value="#7A7A7A" />
    </Style>
</Styles>
