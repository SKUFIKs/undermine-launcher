<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UnderMine.Services.Logger.ProgressView"
             Width="43" Height="43">
    <Grid>
        <!-- Контур круга белый -->
        <Ellipse Stroke="#5C5C5C" StrokeThickness="5" Fill="Transparent"/>
        
        <!-- Дуга прогресса оранжевая -->
        <Path Stroke="Orange" StrokeThickness="5" StrokeLineCap="Round" x:Name="ProgressPath"/>
        
        <!-- Текст процента -->
        <TextBlock x:Name="PercentText" HorizontalAlignment="Center" VerticalAlignment="Center" 
                   FontSize="10" FontWeight="Bold" Foreground="White"/>
    </Grid>
</UserControl>



