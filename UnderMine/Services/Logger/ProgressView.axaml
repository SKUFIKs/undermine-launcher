<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UnderMine.Services.Logger.ProgressView"
             Width="43" Height="43">
    <Grid>
        <Ellipse Stroke="#5C5C5C" StrokeThickness="5" Fill="Transparent"/>

		<Path x:Name="ProgressPath" Stroke="Orange" StrokeThickness="5" StrokeLineCap="Round"/>
        
        <TextBlock x:Name="PercentText" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   FontSize="10" 
                   FontWeight="Bold" 
                   Foreground="White"
                   Text="0%"/>
    </Grid>
</UserControl>

