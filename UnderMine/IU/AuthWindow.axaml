<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="1177" Height="662"
        x:Class="UnderMine.IU.AuthWindow"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent"
        Title="UnderMine">
    <Border CornerRadius="30" BorderThickness="0">
        <Border.Background>
            <ImageBrush Source="avares://UnderMine/Assets/background.jpg"
                        Stretch="UniformToFill" />
        </Border.Background>
        <Panel>
            <Grid x:Name="LogPanel" Height="423" Width="423" Margin="0,0,0,0" IsVisible="True">
                <Border CornerRadius="22" Background="#171717">
                    <Panel>
                        <Label Content="UnderMine Test" Classes="BigTitle" Margin="0,10,0,0" VerticalAlignment="Top"
                               HorizontalAlignment="Center" />
                        <Label Content="Авторизация" Classes="LiteTitle" Margin="0,60,0,0" VerticalAlignment="Top"
                               HorizontalAlignment="Center" />

                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,85,0,0" Width="386"
                              Height="72">
                            <Label Content="Введите логин" Classes="LiteLabel" Margin="5,0,0,0" VerticalAlignment="Top"
                                   HorizontalAlignment="Left" />
                            <TextBox Classes="custom-textbox" Margin="0,0,0,0" TextInput="LogBox_OnTextInput"
                                     x:Name="LogBox" VerticalAlignment="Bottom"
                                     Width="386" Height="45" HorizontalAlignment="Center">
                            </TextBox>
                        </Grid>

                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,155,0,0" Width="386"
                              Height="72">
                            <Label Content="Введите пароль" Classes="LiteLabel" Margin="5,0,0,0"
                                   VerticalAlignment="Top" HorizontalAlignment="Left" />
                            <TextBox Classes="custom-textbox" Margin="0,0,0,0" x:Name="PassBox"
                                     VerticalAlignment="Bottom"
                                     Width="386" Height="45" HorizontalAlignment="Center">
                            </TextBox>
                        </Grid>

                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,235,0,0" Width="386"
                              Height="72">
                            <Label Content="Запомнить меня" Classes="LiteLabel" Margin="35,0,0,0"
                                   VerticalAlignment="Top" HorizontalAlignment="Left" />
                            <CheckBox  x:Name="SaveUserBox" Checked="SaveUserBox_OnChecked" Unchecked="SaveUserBox_OnChecked" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,3,0,0"></CheckBox>

                            <Label Content="Показать пароль" Classes="LiteLabel" Margin="35,30,0,0"
                                   VerticalAlignment="Top" HorizontalAlignment="Left" />
                            <CheckBox x:Name="ShowPassBox" Checked="ShowPassBox_OnChecked" Unchecked="ShowPassBox_OnChecked" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,33,0,0"></CheckBox>
                        </Grid>
                        <Grid Margin="0,25,0,0">
                            <Button x:Name="Registration" Content="Нет аккаунта? Зарегистрироваться" Classes="LiteLabel" Margin="20,280,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Click="Registration_OnClick" />
                            <Button x:Name="AuthButton" Content="Авторизоваться" Margin="0,298,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Classes="custom-Auth" Click="AuthButton_OnClick" />
                        </Grid>
                    </Panel>
                </Border>
            </Grid>
            <Grid x:Name="RegPanel" Height="423" Width="423" Margin="0,0,0,0" IsVisible="False">
                <Border CornerRadius="22" Background="#171717">
                    <Panel>
                        <Label Content="UnderMine Test" Classes="BigTitle" Margin="0,10,0,0" VerticalAlignment="Top"
                               HorizontalAlignment="Center" />
                        <Label Content="Регистрация" Classes="LiteTitle" Margin="0,60,0,0" VerticalAlignment="Top"
                               HorizontalAlignment="Center" />

                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,85,0,0" Width="386"
                              Height="72">
                            <Label Content="Введите логин" Classes="LiteLabel" Margin="5,0,0,0" VerticalAlignment="Top"
                                   HorizontalAlignment="Left" />
                            <TextBox Classes="custom-textbox" Margin="0,0,0,0" TextInput="LogBox_OnTextInput"
                                     x:Name="RegLogBox" VerticalAlignment="Bottom"
                                     Width="386" Height="45" HorizontalAlignment="Center">
                            </TextBox>
                        </Grid>
                        
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,155,0,0" Width="386"
                              Height="72">
                            <Label Content="Введите пароль" Classes="LiteLabel" Margin="5,0,0,0"
                                   VerticalAlignment="Top" HorizontalAlignment="Left" />
                            <TextBox Classes="custom-textbox" Margin="0,0,0,0" x:Name="RegPassBox"
                                     VerticalAlignment="Bottom"
                                     Width="386" Height="45" HorizontalAlignment="Center">
                            </TextBox>
                        </Grid>

                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,225,0,0" Width="386"
                              Height="72">
                            <Label Content="Подтвердите пароль" Classes="LiteLabel" Margin="5,0,0,0"
                                   VerticalAlignment="Top" HorizontalAlignment="Left" />
                            <TextBox Classes="custom-textbox" Margin="0,0,0,0" x:Name="ConfPassBox"
                                     VerticalAlignment="Bottom"
                                     Width="386" Height="45" HorizontalAlignment="Center">

                            </TextBox>
                        </Grid>
                        <Button x:Name="LoginButton"
                                Content="Есть аккаунт? Авторизоваться"
                                Classes="LiteLabel"
                                Margin="20,305,0,0"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Click="LoginButton_OnClick" />
                        
                        <Button x:Name="RegButton"
                                Content="Зарегистрироваться"
                                Classes="custom-Auth"
                                Margin="0,327,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="RegButton_OnClick" />
                    </Panel>
                </Border>
            </Grid>
            <Grid x:Name="ErrorPanel" Height="423" Width="423" IsVisible="False">
                <Panel>
                    <Border CornerRadius="22" Background="#171717">
                    </Border>
                </Panel>
                <Panel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,80,0,0" Height="117" Width="117">
                    <Border>
                        <Border.Background>
                            <ImageBrush Source="avares://UnderMine/Assets/ErrorIcon.jpg" Stretch="Fill"></ImageBrush>
                        </Border.Background>
                    </Border>
                </Panel>
                <Panel>
                    <Label Content="UnderMine Test" Classes="BigTitle" Margin="0,10,0,0" VerticalAlignment="Top"
                           HorizontalAlignment="Center" />
                    <Label Content="Кажется что-то пошло не так..." FontSize="16" Classes="LiteTitle" Margin="0,60,0,0"
                           VerticalAlignment="Top" HorizontalAlignment="Center" />
                </Panel>
                <Panel>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,170,0,0" Width="386"
                          Height="72">
                        <Label Content="Код ошибки:" Classes="LiteLabel" Margin="5,0,0,0" VerticalAlignment="Top"
                               HorizontalAlignment="Left" />
                        <TextBox Classes="custom-textbox" Margin="0,175,0,0" VerticalContentAlignment="Top" TextWrapping="Wrap"  IsReadOnly="True"  AcceptsReturn="True" HorizontalContentAlignment="Left" Padding="5,5" x:Name="ErrorBox"
                                 VerticalAlignment="Bottom"
                                 Width="386" Height="145" HorizontalAlignment="Center">
                        </TextBox>
                        <Button x:Name="CloseErrorButton"
                                Content="Закрыть"
                                Classes="custom-Auth"
                                Margin="0,195,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Click="CloseErrorButton_OnClick" />
                    </Grid>
                </Panel>
            </Grid>
            <Grid x:Name="InfoPanel" Height="442" Width="423" IsVisible="False">
                <Panel>
                    <Border CornerRadius="22" Background="#171717">
                        
                    </Border>
                </Panel>
                <Panel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,80,0,0" Height="117" Width="117">
                    <Border>
                        <Border.Background>
                            <ImageBrush Source="avares://UnderMine/Assets/SuccessIcon.jpg" Stretch="Fill"></ImageBrush>
                        </Border.Background>
                    </Border>
                </Panel>
                <Panel>
                    <Label Content="UnderMine Test" Classes="BigTitle" Margin="0,10,0,0" VerticalAlignment="Top"
                           HorizontalAlignment="Center" />
                    <Label Content="Регистрация пройдена." FontSize="16" Classes="LiteTitle" Margin="0,60,0,0"
                           VerticalAlignment="Top" HorizontalAlignment="Center" />
                </Panel>
                <Panel>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,170,0,0" Width="300"
                          Height="72">
                        <Label Content="Код ошибки:" Classes="LiteLabel" Margin="5,0,0,0" VerticalAlignment="Top"
                               HorizontalAlignment="Left" />
                        <TextBox Classes="custom-textbox" Margin="0,175,0,0" VerticalContentAlignment="Top" TextWrapping="Wrap"  IsReadOnly="True"  AcceptsReturn="True" HorizontalContentAlignment="Left" Padding="5,5" x:Name="InfoBox"
                                 VerticalAlignment="Bottom"
                                 Width="386" Height="145" HorizontalAlignment="Center">
                        </TextBox>
                        
                    </Grid>
                    <Button x:Name="CloseButton"
                            Content="Закрыть"
                            Classes="custom-Auth"
                            Margin="0,0,0,60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="CloseButton_OnClick" />
                </Panel>
            </Grid>
        </Panel>
    </Border>
</Window>