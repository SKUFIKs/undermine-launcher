<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="1024" Height="576"
        x:Class="UnderMine.IU.SettingsWindow"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent"
        Title="UnderMine">

    <Border CornerRadius="30" BorderThickness="0">
        <Border.Background>
            <ImageBrush Source="avares://UnderMine/Assets/backgroundSettings.jpg"
                        Stretch="UniformToFill" />
        </Border.Background>
        <Grid>
            <Border Width="83.95"
                    Height="576"
                    Margin="4,4,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <Image Source="avares://UnderMine/Assets/leftPanelSettings.jpg"
                       Stretch="UniformToFill" />

            </Border>
            <Button Height="50" Width="50" Margin="21,485,0,0"
                    x:Name="ExitButton"
                    Click="ExitButton_OnClick"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    BorderThickness="0"
                    Foreground="White"
                    RenderTransformOrigin="0.5,0.5"
                    Cursor="Arrow">

                <Button.Styles>
                    <!-- Кастомный Template -->
                    <Style Selector="Button">
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="0">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </ControlTemplate>
                        </Setter>
                        <Setter Property="Background">
                            <ImageBrush Source="avares://UnderMine/Assets/exitButton.jpg" Stretch="UniformToFill" />
                        </Setter>
                    </Style>

                    <!-- Стиль для наведения -->
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background">
                            <ImageBrush Source="avares://UnderMine/Assets/exitButton_disabled.jpg"
                                        Stretch="UniformToFill" />
                        </Setter>
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>

                    <!-- Стиль для нажатия -->
                    <Style Selector="Button:pressed">
                        <Setter Property="Background">
                            <ImageBrush Source="avares://UnderMine/Assets/exitButton_disabled.jpg"
                                        Stretch="UniformToFill" />
                        </Setter>
                    </Style>
                </Button.Styles>
            </Button>
            <Button Height="50" Width="50" Margin="21,375,0,0"
                    x:Name="BackButton"
                    Click="BackButton_OnClick"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    BorderThickness="0"
                    Foreground="White"
                    RenderTransformOrigin="0.5,0.5"
                    Cursor="Arrow">

                <Button.Styles>
                    <!-- Кастомный Template -->
                    <Style Selector="Button">
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="0">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </ControlTemplate>
                        </Setter>
                        <Setter Property="Background">
                            <ImageBrush Source="avares://UnderMine/Assets/exitButton.jpg" Stretch="UniformToFill" />
                        </Setter>
                    </Style>

                    <!-- Стиль для наведения -->
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background">
                            <ImageBrush Source="avares://UnderMine/Assets/exitButton_disabled.jpg"
                                        Stretch="UniformToFill" />
                        </Setter>
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>

                    <!-- Стиль для нажатия -->
                    <Style Selector="Button:pressed">
                        <Setter Property="Background">
                            <ImageBrush Source="avares://UnderMine/Assets/exitButton_disabled.jpg"
                                        Stretch="UniformToFill" />
                        </Setter>
                    </Style>
                </Button.Styles>
            </Button>
            <Canvas>
                <Border Width="909" Height="576"
                        Canvas.Left="113"
                        Canvas.Top="0">
                    <Grid>
                        <Label Content="Настрока игры" HorizontalAlignment="Left" VerticalAlignment="Top"
                               FontFamily="Montserrat-VariableFont_wght" FontSize="40" Padding="5,10"
                               FontWeight="Black" Foreground="#FFFFFF">
                        </Label>
                        <Panel Width="450" Height="100" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="0,60,0,0">
                            <Label Content="Настройки графики:" Margin="0,0,0,0" HorizontalAlignment="Left"
                                   VerticalAlignment="Top" FontFamily="Montserrat-VariableFont_wght" FontSize="16"
                                   Padding="5,10" FontWeight="Bold" Foreground="#929292" FontStyle="Italic">
                            </Label>
                            <CheckBox HorizontalAlignment="Left" Margin="40,13,0,0" VerticalAlignment="Center"> </CheckBox>
                            <CheckBox HorizontalAlignment="Left" Margin="126,13,0,0" VerticalAlignment="Center"> </CheckBox>
                            <CheckBox HorizontalAlignment="Left" Margin="212,13,0,0" VerticalAlignment="Center"> </CheckBox>
                            <CheckBox HorizontalAlignment="Left" Margin="298,13,0,0" VerticalAlignment="Center"> </CheckBox>
                            <CheckBox HorizontalAlignment="Left" Margin="384,13,0,0" VerticalAlignment="Center"> </CheckBox>
                            <Label Content="Минимальные" Margin="0,15,0,0" HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom" FontFamily="Montserrat-VariableFont_wght" FontSize="13"
                                   Padding="5,10" FontWeight="SemiBold" Foreground="#929292" FontStyle="Italic">
                            </Label>
                            <Label Content="Средние" Margin="103,15,0,0" HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom" FontFamily="Montserrat-VariableFont_wght" FontSize="13"
                                   Padding="5,10" FontWeight="SemiBold" Foreground="#929292" FontStyle="Italic">
                            </Label>
                            <Label Content="Высокие" Margin="188,15,0,0" HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom" FontFamily="Montserrat-VariableFont_wght" FontSize="13"
                                   Padding="5,10" FontWeight="SemiBold" Foreground="#929292" FontStyle="Italic">
                            </Label>
                            <Label Content="Ультра" Margin="280,15,0,0" HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom" FontFamily="Montserrat-VariableFont_wght" FontSize="13"
                                   Padding="5,10" FontWeight="SemiBold" Foreground="#929292" FontStyle="Italic">
                            </Label>
                            <Label Content="Другие" Margin="366,15,0,0" HorizontalAlignment="Left"
                                   VerticalAlignment="Bottom" FontFamily="Montserrat-VariableFont_wght" FontSize="13"
                                   Padding="5,10" FontWeight="SemiBold" Foreground="#929292" FontStyle="Italic">
                            </Label>
                        </Panel>
                        <Panel Width="436" Height="100" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Margin="0,-170,0,0">
                            <Label Content="Настройки памяти:" Margin="0,-10,0,0" HorizontalAlignment="Left"
                                   VerticalAlignment="Top" FontFamily="Montserrat-VariableFont_wght" FontSize="16"
                                   Padding="5,10" FontWeight="Bold" Foreground="#929292" FontStyle="Italic">
                            </Label>

                            <Panel Width="396" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Slider x:Name="MemorySlider" ValueChanged="MemorySlider_ValueChanged"
                                        IsSnapToTickEnabled="True" Minimum="2048" Maximum="16384"
                                        TickFrequency="2048">
                                </Slider>
                            </Panel>
                            <Grid Width="418" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="0,50,0,0">
                                <Label Content="2048" Margin="-209,0,0,0" HorizontalAlignment="Center"
                                       FontFamily="Montserrat-VariableFont_wght" FontSize="13" Padding="5,0"
                                       FontWeight="SemiBold" Foreground="#929292" FontStyle="Italic">
                                </Label>
                                <Label Content="4096" Margin="-156.75,0,0,0" HorizontalAlignment="Center"
                                       FontFamily="Montserrat-VariableFont_wght" FontSize="13" Padding="5,0"
                                       FontWeight="SemiBold" Foreground="#929292" FontStyle="Italic">
                                </Label>
                                <Label Content="6144" Margin="-104.5,0,0,0" HorizontalAlignment="Center"
                                       FontFamily="Montserrat-VariableFont_wght" FontSize="13" Padding="5,0"
                                       FontWeight="SemiBold" Foreground="#929292" FontStyle="Italic">
                                </Label>
                                <Label Content="8192" Margin="-49,0,0,0" HorizontalAlignment="Center"
                                       FontFamily="Montserrat-VariableFont_wght" FontSize="13" Padding="5,0"
                                       FontWeight="SemiBold" Foreground="#929292" FontStyle="Italic">
                                </Label>
                                <Label Content="10240" Margin="52.25,0,0,0" HorizontalAlignment="Center"
                                       FontFamily="Montserrat-VariableFont_wght" FontSize="13" Padding="5,0"
                                       FontWeight="SemiBold" Foreground="#929292" FontStyle="Italic">
                                </Label>
                                <Label Content="12288" Margin="156.75,0,0,0" HorizontalAlignment="Center"
                                       FontFamily="Montserrat-VariableFont_wght" FontSize="13" Padding="5,0"
                                       FontWeight="SemiBold" Foreground="#929292" FontStyle="Italic">
                                </Label>
                                <Label Content="14336" Margin="261.75,0,0,0" HorizontalAlignment="Center"
                                       FontFamily="Montserrat-VariableFont_wght" FontSize="13" Padding="5,0"
                                       FontWeight="SemiBold" Foreground="#929292" FontStyle="Italic">
                                </Label>
                                <Label Content="16384" Margin="365.5,0,0,0" HorizontalAlignment="Center"
                                       FontFamily="Montserrat-VariableFont_wght" FontSize="13" Padding="5,0"
                                       FontWeight="SemiBold" Foreground="#929292" FontStyle="Italic">
                                </Label>
                            </Grid>
                        </Panel>

                        <Panel Width="535" Height="77" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Margin="0,-15,0,0">
                            <Label Content="Папка установки игры:" Margin="0,0,0,0" HorizontalAlignment="Left"
                                   VerticalAlignment="Top" FontFamily="Montserrat-VariableFont_wght" FontSize="16"
                                   Padding="5,10" FontWeight="Bold" Foreground="#929292" FontStyle="Italic">
                            </Label>
                            <TextBox Width="427" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="0,25,0,0" FontSize="10">
                            </TextBox>
                            <Button Height="30" x:Name="InstallationOverviewButton"
                                    Click="InstallationOverviewButton_OnClick" Width="90" HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,25,0,0">
                            </Button>
                        </Panel>
                        <Panel Width="295" Height="70" HorizontalAlignment="Left" Margin="0,385,0,0">
                            <Button x:Name="SaveSettingsButton"
                                    Click="SaveSettingsButton_OnClick"
                                    Content="Применить"
                                    Height="38"
                                    Width="137"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Margin="5,0,0,0"
                                    FontWeight="Black"
                                    FontSize="15"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    BorderThickness="0"
                                    FontFamily="Montserrat-VariableFont_wght"
                                    RenderTransformOrigin="0.5,0.5"
                                    Cursor="Arrow">

                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Template">
                                            <ControlTemplate>
                                                <Border Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="0">
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter>
                                        <Setter Property="Background">
                                            <ImageBrush Source="avares://UnderMine/Assets/applyButton.jpg"
                                                        Stretch="UniformToFill" />
                                        </Setter>
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background">
                                            <ImageBrush Source="avares://UnderMine/Assets/appluButton_disabled.jpg"
                                                        Stretch="UniformToFill" />
                                        </Setter>
                                        <Setter Property="Cursor" Value="Hand" />
                                    </Style>

                                    <!-- Стиль для нажатия -->
                                    <Style Selector="Button:pressed">
                                        <Setter Property="Background">
                                            <ImageBrush Source="avares://UnderMine/Assets/appluButton_disabled.jpg"
                                                        Stretch="UniformToFill" />
                                        </Setter>
                                    </Style>
                                </Button.Styles>
                            </Button>

                            <Button x:Name="DefaultSettingsButton" Click="DefaultSettingsButton_OnClick"
                                    Content="По умолчанию" Height="38"
                                    Width="137"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Margin="0,0,0,0"
                                    FontWeight="Black"
                                    FontSize="15"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    BorderThickness="0"
                                    FontFamily="Montserrat-VariableFont_wght"
                                    RenderTransformOrigin="0.5,0.5"
                                    Cursor="Arrow">

                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Template">
                                            <ControlTemplate>
                                                <Border Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="0">
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter>
                                        <Setter Property="Background">
                                            <ImageBrush Source="avares://UnderMine/Assets/applyButton.jpg"
                                                        Stretch="UniformToFill" />
                                        </Setter>
                                    </Style>

                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background">
                                            <ImageBrush Source="avares://UnderMine/Assets/appluButton_disabled.jpg"
                                                        Stretch="UniformToFill" />
                                        </Setter>
                                        <Setter Property="Cursor" Value="Hand" />
                                    </Style>

                                    <Style Selector="Button:pressed">
                                        <Setter Property="Background">
                                            <ImageBrush Source="avares://UnderMine/Assets/appluButton_disabled.jpg"
                                                        Stretch="UniformToFill" />
                                        </Setter>
                                    </Style>
                                </Button.Styles>
                            </Button>
                        </Panel>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>
    </Border>
</Window>