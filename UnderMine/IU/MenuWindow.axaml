<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:UnderMine.Fonts.Models"
        xmlns:logger="clr-namespace:UnderMine.Services.Logger"
        mc:Ignorable="d"
        x:Class="UnderMine.IU.MenuWindow"
        RenderOptions.BitmapInterpolationMode="MediumQuality"
        UseLayoutRounding="True"
        Width="1177" Height="662"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent"
        Title="UnderMine">

	<Window.Styles>
		<Style Selector="Border.Card">
			<Setter Property="Background" Value="#222222"/>
			<Setter Property="CornerRadius" Value="15"/>
		</Style>
		<Style Selector="RadioButton.menu-btn">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="RadioButton.menu-btn TextBlock">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="Panel.ContentPage">
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Width" Value="910"/>
			<Setter Property="Height" Value="662"/>
		</Style>
		<Style Selector="Panel.ContentPage > Border">
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="Width" Value="876"/>
			<Setter Property="Height" Value="513"/>
			<Setter Property="Margin" Value="0,40,30,0"/>
			<Setter Property="Background" Value="#222222"/>
			<Setter Property="CornerRadius" Value="15"/>
		</Style>
	</Window.Styles>

	<Panel>
		<Border Background="#171717" CornerRadius="30" ClipToBounds="True" PointerPressed="TitleBar_PointerPressed">

			<Grid ColumnDefinitions="263, *">

				<Grid Grid.Column="0" RowDefinitions="Auto, *">

					<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="23,25,0,0" HorizontalAlignment="Center">
						<Image Source="avares://UnderMine/Assets/Images/UnderMineIcon.jpg"
							   Width="50"
							   Height="50"
							   Stretch="Fill"/>

						<StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
							<Label Classes="LiteTitle" Content="UnderMine" FontSize="20" Padding="0"/>
							<Label Classes="LiteTitle" Content="Server" FontSize="20" Padding="0"/>
						</StackPanel>
					</StackPanel>
					

					<StackPanel Grid.Row="1" Spacing="15" Margin="40,40,0,0" VerticalAlignment="Center">
						<RadioButton x:Name="NewsButton" Click="NewsButton_OnClick" GroupName="MenuGroup" Classes="menu-btn" IsChecked="True">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Image Source="avares://UnderMine/Assets/Images/news.jpg" Width="20" Height="20" />
								<TextBlock Text="Новости" />
							</StackPanel>
						</RadioButton>

						<RadioButton x:Name="ServerSelectionButton" Click="ServerSelectionButton_OnClick" GroupName="MenuGroup" Classes="menu-btn">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Image Source="avares://UnderMine/Assets/Images/servers.jpg" Width="20" Height="20" />
								<TextBlock Text="Сервера" />
							</StackPanel>
						</RadioButton>

						<RadioButton x:Name="ProfileButton" Click="ProfileButton_OnClick" GroupName="MenuGroup" Classes="menu-btn">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Image Source="avares://UnderMine/Assets/Images/profile.jpg" Width="20" Height="20" />
								<TextBlock Text="Профиль" />
							</StackPanel>
						</RadioButton>

						<RadioButton x:Name="SettingsButton" Click="SettingsButton_OnClick" GroupName="MenuGroup" Classes="menu-btn">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Image Source="avares://UnderMine/Assets/Images/settings.jpg" Width="20" Height="20" />
								<TextBlock Text="Настройки" />
							</StackPanel>
						</RadioButton>

						<Panel Height="30"/>

						<RadioButton x:Name="ExitButton" Click="ExitButton_OnClick" GroupName="MenuGroup" Classes="menu-btn">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<Image Source="avares://UnderMine/Assets/Images/exit.jpg" Width="20" Height="20" />
								<TextBlock Text="Выход" />
							</StackPanel>
						</RadioButton>
					</StackPanel>
			
				</Grid>

				<Panel Grid.Column="1">

					<StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,30,0" Spacing="10" ZIndex="10">
						<Border Width="200" Height="65" Background="#222222" CornerRadius="15" >
							<Grid ColumnDefinitions="Auto,*" Margin="10">
								<Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" ClipToBounds="True">
									<Border.Background>
										<ImageBrush Source="avares://UnderMine/Assets/Images/profile.jpg" Stretch="UniformToFill"/>
									</Border.Background>
								</Border>
								<Label x:Name="UsernameLabel" Grid.Column="1" Classes="LiteLabel" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" FontSize="16"/>
							</Grid>
						</Border>
					</StackPanel>
					<Grid Margin="0,0,10,0"  Height="20" Width="200" VerticalAlignment="Bottom" HorizontalAlignment="Right" >
						<Label x:Name="Version" Classes="LiteLabel" Margin="0,0,0,0"  Height="40" Width="200" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize ="12" HorizontalContentAlignment="Right" />
					</Grid>

					<Panel x:Name="NewsPanel" Classes="ContentPage" IsVisible="True">
    <Border>
        <ScrollViewer>
            <TextBlock x:Name="NewsTextBlock" 
                       Classes="NewsTitle" 
                       Margin="20" 
                       TextWrapping="Wrap" 
                       Foreground="#FFFFFF">
                </TextBlock>
        </ScrollViewer>
    </Border>
</Panel>

					<Panel x:Name="SettingsPanel" Classes="ContentPage" IsVisible="False">
						<Border >
							<Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Margin="25,20,25,20">
								<Label Grid.Row="0" Content="Настройки игры" Classes="BigTitle" FontSize="24" />

								<StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="5" Width="600" HorizontalAlignment="Left">
									<Label Classes="LiteTitle" Content="Память(ОЗУ):" FontSize="15"/>

									<Grid ColumnDefinitions="*, Auto" Margin="20,5,0,0">
										<StackPanel Grid.Column="0" Width="450">
											<Slider x:Name="MemorySlider"
													IsSnapToTickEnabled="True"
													TickPlacement="BottomRight"
													VerticalAlignment="Center"
													Margin="0"/>

											<Grid ColumnDefinitions="*,*,*,*" Margin="10,5,10,0" ClipToBounds="False">

												<Label x:Name="FirstValue"
													   Grid.Column="0"
													   
													   HorizontalAlignment="Left"
													   HorizontalContentAlignment="Center"
													    Margin="-15,0,0,0"
													   FontSize="12" Padding="0"/>

												<Label x:Name="SecondValue"
													   Grid.Column="0" Grid.ColumnSpan="2"
													   
													   HorizontalAlignment="Center"
													   
													   FontSize="12" Padding="0"/>

												<Label x:Name="ThirdValue"
													   Grid.Column="1" Grid.ColumnSpan="2"
													   HorizontalAlignment="Center"
													   FontSize="12" Padding="0"/>
												<Label x:Name="FourthValue"
													   Grid.Column="2" Grid.ColumnSpan="2"
													   HorizontalAlignment="Center"
													   FontSize="12" Padding="0"/>
												<Label x:Name="FifthValue"
													   Grid.Column="3"
													   HorizontalAlignment="Right"
													   HorizontalContentAlignment="Center"
													    Margin="0,0,-15,0"
													   FontSize="12" Padding="0"/>
											</Grid>
										</StackPanel>


										<TextBox Grid.Column="1"
												 x:Name="MemoryTextBox"
												 Width="95" Height="35"
												 Margin="15,0,0,0"
												 IsReadOnly="True"
												 VerticalAlignment="Top"
												 VerticalContentAlignment="Center"
												 HorizontalContentAlignment="Center"/>
									</Grid>
								</StackPanel>

								<StackPanel Grid.Row="2" Margin="0,20,0,0" Spacing="5" MaxWidth="600" HorizontalAlignment="Left">
									<Label Classes="LiteTitle" Content="Путь установки игры:" FontSize="15"/>
									<Grid ColumnDefinitions="*, Auto" Margin="20,5,0,0">
										<TextBox Grid.Column="0" x:Name="InstallationPath" Margin="0,0,20,0"/>
										<Button Grid.Column="1" x:Name="OverviewSettings" Click="OverviewSettings_OnClick"
												Content="Обзор" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="90" Background="SlateGray"/>
									</Grid>
								</StackPanel>

								<StackPanel Grid.Row="3" Margin="0,20,0,0" Spacing="5" IsVisible="False" MaxWidth="550" HorizontalAlignment="Left">
									<Label Classes="LiteTitle" Content="Логи игры:" FontSize="15"/>
									<Grid ColumnDefinitions="*, Auto" Margin="20,5,0,0">
										<TextBox Grid.Column="0" x:Name="LogsPath" Margin="0,0,20,0"/>
										<Button Grid.Column="1" x:Name="LogsSettings" Click="LogsSettings_OnClick"
												Content="Обзор" Width="90" Background="SlateGray"/>
									</Grid>
								</StackPanel>
								<StackPanel Grid.Row="3" Margin="0,20,0,0" Spacing="5" Width="600" HorizontalAlignment="Left">
    <Label Classes="LiteTitle" Content="Путь к исполняемому файлу Java:" FontSize="15"/>
    <Grid ColumnDefinitions="*, Auto" Margin="20,5,0,0">
        <TextBox Grid.Column="0" 
                 x:Name="JavaPathTextBox" 
                 Watermark="Напр: C:\Program Files\Java\bin\javaw.exe"
                 Margin="0,0,20,0"/>
        <Button Grid.Column="1" 
                x:Name="JavaPathBrowseButton" 
                Click="JavaPathBrowseButton_OnClick"
                Content="Обзор" 
                HorizontalContentAlignment="Center" 
                VerticalContentAlignment="Center" 
                Width="90" 
                Background="SlateGray"/>
    </Grid>
</StackPanel>
								

								<StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="20" Margin="10,0,0,10">
									<Button x:Name="SaveButton" Click="SaveButton_OnClick" Classes="menu-btn" Width="158" Height="45"
											HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#333">
										<TextBlock Text="Сохранить" />
									</Button>
									<Button x:Name="DefaultButton" Click="DefaultButton_OnClick" Classes="menu-btn" Width="158" Height="45"
											HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#333">
										<TextBlock Text="По умолчанию" />
									</Button>
								</StackPanel>
							</Grid>
						</Border>
					</Panel>

					<Panel x:Name="ProfilePanel" Classes="ContentPage" IsVisible="False">
						<Border >
							<StackPanel Margin="26,20,0,0">
								<Label Content="Игровой профиль" Classes="BigTitle" FontSize="24"/>
								<Label Classes="LiteTitle" Margin="0,20,0,0" FontSize="15"
                                       Content="Игровой профиль еще не готов. Мы сообщим, когда он будет реализован."/>
							</StackPanel>
						</Border>
					</Panel>

					<Panel x:Name="PlayServer" Classes="ContentPage" IsVisible="False">
						<Border >
							<Grid RowDefinitions="*, 120">
								<ScrollViewer Grid.Row="0" Margin="20">
									<TextBlock x:Name="ServerDescriptionText" TextWrapping="Wrap" Classes="NewsTitle" Foreground="White"> </TextBlock>
								</ScrollViewer>

								<Panel Grid.Row="1" Margin="25,30,0,0">
									<Button x:Name="PlayButton"
											VerticalAlignment="Top"
											Click="PlayButton_OnClick"
											Content="Играть"
											Classes="custom-Auth"
											HorizontalAlignment="Left"/>

									<Label x:Name="LogLabel"
										   VerticalAlignment="Bottom"
										   Classes="LiteLabel"
										   FontSize="11"
										   Foreground="#4B4B4B"
										   Margin="0,0,0,0"/>
								</Panel>
							</Grid>
						</Border>
					</Panel>

					<Panel x:Name="WaitingСhoice" Classes="ContentPage" IsVisible="False">
						<Border  />
					</Panel>
				</Panel>
			</Grid>
		</Border>

		<Border x:Name="SelectServer" Width="442" Height="415" Background="#171717" CornerRadius="22" IsVisible="False" >
			<Panel x:DataType="models:MenuWindowViewModel">
				<StackPanel VerticalAlignment="Top" Margin="0,10,0,0">
					<Label Content="UnderMine" Classes="BigTitle" HorizontalAlignment="Center"/>
					<Label Content="Выбор сервера" Classes="LiteTitle" Margin="0,15,0,0" HorizontalAlignment="Center"/>
				</StackPanel>

				<Border Margin="30,80,30,80" Background="#3B3B3B" BorderBrush="#747474" BorderThickness="2" CornerRadius="10" >
					<ListBox CornerRadius="10" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer, Mode=TwoWay}">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="models:Server">
								<TextBlock Text="{Binding Name}" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Border>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Spacing="20">
					<RadioButton x:Name="SelectButton" Click="SelectButton_OnClick" GroupName="ServerGroup" Classes="menu-btn"
                                 Width="158" Height="45" HorizontalContentAlignment="Center" IsChecked="True">
						<TextBlock Text="Выбрать" />
					</RadioButton>
					<RadioButton x:Name="CancelButton" Click="CancelButton_OnClick" GroupName="ServerGroup" Classes="menu-btn"
                                 Width="158" Height="45" HorizontalContentAlignment="Center">
						<TextBlock Text="Отменить" />
					</RadioButton>
				</StackPanel>
			</Panel>
		</Border>

		<Grid x:Name="ErrorPanel" Width="423" Height="423" IsVisible="False">
			<Border CornerRadius="22" Background="#171717">
				<Grid RowDefinitions="Auto, Auto, Auto, Auto" VerticalAlignment="Center" Margin="30,10,30,10">

					<Image Source="avares://UnderMine/Assets/Images/ErrorIcon.jpg"
						   Width="100" Height="100"
						   Stretch="Uniform"
						   Margin="0,0,0,20"/>

					<StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,-30">
						<Label Content="UnderMine" Classes="BigTitle" HorizontalAlignment="Center" FontSize="36" FontWeight="Bold"/>
						<Label Content="Кажется что-то пошло не так..." FontSize="16" Classes="LiteTitle" Margin="0,0,0,0" HorizontalAlignment="Center"/>
					</StackPanel>

					<Grid Grid.Row="2" Margin="0,30,0,0">
						<TextBox x:Name="ErrorBox"
								 Classes="custom-paneltextbox"
								 IsReadOnly="True"
								 TextWrapping="Wrap"
								 AcceptsReturn="True"
								 VerticalContentAlignment="Top"
								 HorizontalContentAlignment="Left"
								 IsHitTestVisible="False"
								 Height="160"
								 Width="365"
								 Background="#252525"
								 BorderThickness="1"
								 BorderBrush="#444444"
								 Padding="10,10"
								 FontSize="13"/>
					</Grid>

					<Button Grid.Row="3"
							x:Name="CloseErrorButton"
							Click="CloseErrorButton_OnClick"
							Content="Закрыть"
							Classes="custom-Auth"
							HorizontalAlignment="Center"
							Margin="0,10,0,0"/>
				</Grid>
			</Border>
		</Grid>
		<Panel x:Name="ProgressBar" IsVisible="False" Width="275" Height="65" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,15,0,0" ZIndex="100">
			<Border Background="#222222" CornerRadius="15">
				<Grid ColumnDefinitions="Auto, *" Margin="15,0">
					<Grid Grid.Column="0" Width="43" Height="43" VerticalAlignment="Center">
						<logger:ProgressView x:Name="Loader" ZIndex="1" />

						<TextBlock x:Name="PercentText"
           Text="0%"
           FontSize="10"
           FontWeight="Bold"
           Foreground="White"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           TextAlignment="Center"
           UseLayoutRounding="True"
           Background="#222222"
           ZIndex="10"/>
					</Grid>

					<Label x:Name="LogBox"
						   Grid.Column="1"
						   VerticalAlignment="Center"
						   Margin="15,0,0,0"
						   FontSize="14"
						   Classes="LiteLabel"
						   Content="Загрузка..."/>
				</Grid>
			</Border>
		</Panel>
	</Panel>
</Window>
