{
  "name": "your-avalonia-app-name",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "build:avalonia": "dotnet publish -c Release -r win-x64 /p:PublishSingleFile=true -o app/AvaloniaBinaries",
    "dist": "npm run build:avalonia && electron-builder"
  },
  "build": {
    "appId": "com.yourcompany.yourapp",
    "productName": "Avalonia App",
    "directories": {
      "output": "dist",
      "app": "app"
    },

    "win": {
      "target": "msi", 
      "icon": "build/icon.ico" 
    },


    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "pkg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "background": "build/background.tiff", 
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        }, 
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        } 
      ]
    },
    "linux": {
      "target": "AppImage", 
      "category": "Utility",
      "icon": "build/icons"
    }
  },
  "devDependencies": {
    "electron-builder": "^24.9.1"
  }
}